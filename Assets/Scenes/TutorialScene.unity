    \u043F\u0443\u0442\u044C. \u0427\u0442\u043E\u0431\u044B \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044C\u0441\u044F
    \u043E\u0442 \u043D\u0438\u0445, \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
    \u0441\u0445\u0432\u0430\u0442\u0438\u0442\u044C \u0438\u0445 \u0438 \u0442\u044F\u043D\u0443\u0442\u044C
    \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443. \u0427\u0435\u0440\u0435\u0437
    \u043A\u0430\u043A\u043E\u0435-\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u0435
