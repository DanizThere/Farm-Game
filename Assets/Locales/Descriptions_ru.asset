  m_SharedData: {fileID: 11400000, guid: 63fb1e0e8a1fdc04b8408a132b2e913b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 4732997632
    m_Localized: "\u042D\u0442\u043E \u043A\u0440\u043E\u0432\u0430\u0442\u044C.
      \u041E\u043D\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043F\u0440\u043E\u0441\u0442\u043E,
      \u043D\u043E \u0442\u044B \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0448\u044C,
      \u0447\u0442\u043E \u043E\u043D\u0430 \u043E\u0447\u0435\u043D\u044C \u0443\u0434\u043E\u0431\u043D\u0430\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 5217430102159360
    m_Localized: "\u0421\u044E\u0434\u0430 \u044F \u043F\u043E\u043F\u0430\u043B\u0430
      \u043F\u043E \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 5217552168988672
    m_Localized: "\u0412\u0441\u0451 \u044D\u0442\u043E \u043D\u0430\u0447\u0430\u043B\u043E\u0441\u044C
      \u043D\u0435 \u0442\u0430\u043A \u0434\u0430\u0432\u043D\u043E. \u042F \u043A\u0430\u043A
      \u043E\u0431\u044B\u0447\u043D\u043E \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430
      \u043F\u043E\u0447\u0442\u0443:"
    m_Metadata:
      m_Items: []
  - m_Id: 5217712454316032
    m_Localized: "\u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435
      \u043E\u0442 \u043C\u0430\u0440\u043A\u0435\u0442\u043F\u043B\u0435\u0439\u0441\u043E\u0432,
      \u043F\u0438\u0441\u044C\u043C\u0430 \u043E\u0442 \u043D\u0438\u0433\u0435\u0440\u0435\u0439\u0441\u043A\u0438\u0445
      \u043F\u0440\u0438\u043D\u0446\u0435\u0432 \u0438 \u043F\u0440\u043E\u0447\u0438\u0439
      \u0441\u043F\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 5217925994721280
    m_Localized: "\u041E\u0434\u043D\u0430\u043A\u043E \u0441\u0440\u0435\u0434\u0438
      \u0432\u0441\u0435\u0445 \u044D\u0442\u0438\u0445 \u043F\u0438\u0441\u044C\u043C
      \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u043E\u0441\u044C \u043E\u0434\u043D\u043E
      \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 5218087026634752
    m_Localized: "\u041C\u043D\u0435 \u0437\u0430\u0432\u0435\u0449\u0430\u043B \u043A\u0430\u043A\u043E\u0439-\u0442\u043E
      \u0447\u0430\u0441\u0442\u043D\u044B\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A
      \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u0434\u0435\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 5218205540888576
    m_Localized: "\u0427\u0435\u0441\u0442\u043D\u043E, \u0443\u0434\u0438\u0432\u0438\u043B\u0430\u0441\u044C.
      \u0412\u0441\u0435 \u043C\u043E\u0438 \u0434\u0435\u0434\u044B \u0438 \u0431\u0430\u0431\u0443\u0448\u043A\u0438
      \u0434\u0430\u0432\u043D\u043E \u0443\u0436\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438\u0441\u044C
      \u043D\u0430 \u0442\u043E\u043C \u0441\u0432\u0435\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 5218401666543616
    m_Localized: "\u0412\u043C\u0435\u0441\u0442\u0435 \u0441 \u044D\u0442\u0438\u043C
      \u0432 \u0437\u0430\u0432\u0435\u0449\u0430\u043D\u0438\u0438 \u0431\u044B\u043B
      \u0447\u0435\u043A \u043D\u0430 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u0443\u044E
      \u0441\u0443\u043C\u043C\u0443, \u0447\u0442\u043E\u0431\u044B \u044F \u0434\u043E\u0431\u0440\u0430\u043B\u0430\u0441\u044C
      \u0434\u043E \u0443\u0447\u0430\u0441\u0442\u043A\u0430. \u0422\u0430\u043A
      \u044F \u0438 \u043F\u043E\u0435\u0445\u0430\u043B\u0430, \u0432\u0437\u044F\u0432
      \u043E\u0442\u043F\u0443\u0441\u043A."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
